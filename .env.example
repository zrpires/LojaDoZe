# Sem chave, o assistente usa regras locais e identifica esse modo na tela.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Obrigatório para liberar chamadas pagas da IA. Não use prefixo NEXT_PUBLIC_.
APP_PASSWORD=
PORT=3000
# Opcional. Sem Stripe, checkout apenas demonstrativo.
STRIPE_SECRET_KEY=
# URL definitiva da loja, sem barra ao final. Necessária para checkout real.
APP_URL=https://sua-loja.vercel.app
